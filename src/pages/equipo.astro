---
import Layout from "../layouts/Layout.astro";
import Separador from '../components/main/Separator.astro';
import iluminacion from "../assets/assets/iluminacion-perfil.svg";
import daniela from "../assets/equipo/cortas/daniela.png";
import santiago from "../assets/equipo/cortas/santiago.png";
import ruben from "../assets/equipo/cortas/ruben.png";
import jean from "../assets/equipo/cortas/jeanB.png";
import jose from '../assets/equipo/cortas/jose.png';
import brito from '../assets/equipo/cortas/brito.png';
import Link from "../components/Link.astro";

const equipo = [
  {
    nombre: "Santiago",
    apellido: "Peña Díaz",
    cargo: "Co-Founder & CEO",
    imagen: santiago,
  },
    {
    nombre: "María Daniela",
    apellido: "Martínez",
    cargo: "Creative Director",
    imagen: daniela,
  },
  {
    nombre: "Rubén",
    apellido: "Riaño",
    cargo: "Client Success",
    bio: "Administrador de Empresas...",
    imagen: ruben,
  },
  {
    nombre: "José Rafael",
    apellido: "Saravia",
    cargo: "Graphic Designer",
    imagen: jose,
  },
  {
    nombre: "José Antonio",
    apellido: "Brito",
    cargo: "Web Programmer",
    imagen: brito,
  },
  {
    nombre: "Jean Franco",
    apellido: "Crestani",
    cargo: "Full Stack Developer",
    imagen: jean,
  },
];
---

<Layout 
  title="Equipo | Smartketing"
  description="Conoce al equipo detrás de Smartketing. Expertos en comunicación y diseño."
>
  <section class="relative bg-transparent w-full min-h-screen overflow-hidden pt-42 pb-20 px-6 lg:px-20">
    
    <div class="relative z-10 max-w-5xl mx-auto">
      <div class="text-center pt-15 md:-mb-16 lg:-mb-18 xl:-mb-22" data-aos="fade-down">
        <h1 class="text-white text-3xl md:text-4xl font-light">
          Nuestro <span class="text-brand-coral font-bold">Equipo</span>
        </h1>
      </div>

      <Separador />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-16 mt-20 lg:mt-32">
        {equipo.map((persona) => (
          <article 
            class="group relative flex flex-col transition-all duration-300 hover:-translate-y-2"
            data-aos="fade-up"
          >
            <div class="relative aspect-[1/1.1] overflow-hidden flex items-end border border-transparent bg-white/2 backdrop-blur-[2px] rounded-t-2xl">
              <img 
                src={iluminacion.src} 
                class="absolute inset-0 w-[130%] h-[130%] -translate-x-[5%] -translate-y-[5%] object-cover mix-blend-screen opacity-60 group-hover:opacity-90 transition-opacity duration-500 pointer-events-none" 
                alt=""
                style="z-index: 1;" />
              
              <img 
                src={persona.imagen.src} 
                alt={persona.nombre} 
                class="relative w-full h-[98%] object-contain object-bottom transition-transform duration-500 group-hover:scale-105 pointer-events-none"
                style="z-index: 2;" />
            </div>

            <div class="bg-white/10 backdrop-blur-md py-4 px-4 text-center shadow-2xl rounded-b-2xl border-x border-b border-white/10 -mt-1 relative" style="z-index: 3;">
              <h3 class="font-title text-xl leading-tight">
                <span class="block text-brand-coral font-bold">{persona.nombre} {persona.apellido}</span>
              </h3>
              
              <p class="text-brand-cyan font-body font-medium text-[0.9rem] uppercase tracking-[0.2em] mt-3">
                {persona.cargo}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="w-full flex justify-center mt-20" data-aos="zoom-in-up">
      <Link 
        href="/contacto" 
        class="bg-brand-coral hover:bg-brand-coral/90 text-base italic text-white font-normal py-3 px-8 rounded-xl transition-all shadow-lg hover:scale-105"
      >
        Conversemos sobre tu marca
      </Link>
    </div>
  </section>
</Layout>