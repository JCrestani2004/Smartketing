---
import Layout from "../layouts/Layout.astro";
import Separador from '../components/main/Separator.astro';
import iconoA from "../assets/iconos/analisis.svg"; // Analisis
import iconoD from "../assets/iconos/icono-hero.svg"; // Direccion
import iconoI from "../assets/iconos/intencion.svg"; // Intencion
import iconoPr from "../assets/iconos/proceso.svg"; // Proceso
import iconoCa from "../assets/iconos/calendario.svg"; // Calendario
import Link from "../components/Link.astro";
---

<Layout
  title="Quiénes Somos | Brandoors"
  description="Más de 10 años acompañando a pymes como su equipo creativo externo. Creamos identidad, mensaje y diseño estratégico para un crecimiento real."
>
  <section
    class="relative w-full min-h-screen bg-transparent overflow-hidden pt-42 pb-20 px-6 lg:px-20"
  >
    <!-- <img
      src={background.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-top pointer-events-none"
    /> -->

    <div class="relative z-10 max-w-5xl mx-auto">
      <div
        class="text-center pt-15 md:-mb-16 lg:-mb-18 xl:-mb-22"
        data-aos="fade-down"
      >
        <h1 class="text-brand-gray font-title text-3xl md:text-4xl font-light">
          Quiénes <span class="text-brand-coral font-bold">Somos</span>
        </h1>
      </div>

      <Separador />

      <article
        class="space-y-10 -mb-10 max-w-3xl mx-auto text-justify"
        data-aos="fade-up"
      >
        <p
          class="text-brand-gray/90 text-sm md:text-lg font-body font-extralight leading-relaxed"
        >
          En Brandoors somos un estudio de comunicación estratégica que
          acompaña a pequeñas y medianas empresas a construir y posicionar su
          marca en el tiempo.
        </p>

        <div
          class="grid grid-cols-1 gap-8 text-brand-gray/90 font-body font-extralight text-sm md:text-lg leading-relaxed"
        >
          <p>
            Trabajamos como el equipo creativo y de comunicación externo de
            nuestros clientes, ayudándolos a definir cómo se ven, cómo hablan y
            cómo se presentan a través de contenido, diseño y una comunicación
            coherente y constante.
          </p>
          <p>
            Antes de ejecutar, analizamos. Por eso iniciamos nuestros procesos
            con una auditoría comercial y de ventas, donde entendemos el
            negocio, identificamos oportunidades y detectamos los puntos que
            necesitan orden para crecer con claridad.
          </p>
          <p>
            Creemos en procesos, no en soluciones rápidas. Nuestro enfoque está
            en construir marcas sólidas, con criterio y visión a largo plazo,
            donde vender sea una consecuencia natural de una comunicación bien
            hecha.
          </p>
        </div>
      </article>

      <div
        class="text-center mt-35 md:-mb-16 lg:-mb-18 xl:-mb-22"
        data-aos="fade-right"
      >
        <h2
          class="font-title text-3xl md:text-4xl leading-none font-light text-brand-gray"
        >
          Cómo
          <span class="text-brand-coral font-bold">trabajamos</span>
        </h2>
      </div>

      <Separador />

      <div class="space-y-12">
        {
          [
            {
              num: "1.  ",
              title: "Entendemos la marca",
              text: "Antes de crear cualquier pieza, nos tomamos el tiempo de conocer la historia, el contexto y los objetivos del negocio. Analizamos dónde está la marca hoy y hacia dónde quiere ir, para que cada decisión tenga sentido.",
              logo: iconoA,
            },
            {
              num: "2.  ",
              title: "Definimos una dirección clara",
              text: "A partir de ese entendimiento, establecemos una dirección creativa y estratégica: cómo debe verse la marca, cómo debe comunicar y qué tipo de contenido necesita para posicionarse de forma coherente en el tiempo.",
              logo: iconoD,
            },
            {
              num: "3.  ",
              title: "Creamos con intención",
              text: "Desarrollamos contenido, diseño y piezas de comunicación alineadas a esa dirección. No trabajamos por volumen, sino por coherencia, calidad y consistencia, cuidando cada punto de contacto de la marca.",
              logo: iconoI,
            },
            {
              num: "4.  ",
              title: "Acompañamos el proceso",
              text: "Trabajamos de forma cercana y continua, ajustando, organizando y acompañando la evolución de la marca. Nos integramos como equipo externo, para que la comunicación fluya sin improvisación.",
              logo: iconoPr,
            },
            {
              num: "5.  ",
              title: "Pensamos a largo plazo",
              text: "Creemos en procesos sostenibles. Nuestro enfoque no es inmediato ni reactivo, sino estratégico: construir una marca sólida que pueda crecer con claridad y visión.",
              logo: iconoCa,
            },
          ].map((step, index) => (
            <>
              <div
                class="-mb-3 md:-mb-15"
                data-aos="fade-up"
                data-aos-delay={index * 100}
              >
                <div class="flex flex-col gap-3 items-center">
                  <img
                    src={step.logo.src}
                    alt={step.title}
                    class="w-32 h-auto mb-2 object-contain scale-105"
                  />
                  <div class="flex text-2xl text/90-center gap-0.5">
                    
                    <h3 class="text-brand-cyan/90 font-title font-bold tracking-tight uppercase">
                      {step.title}
                    </h3>
                  </div>
                  <p class="text-brand-gray/90 text-justify font-body font-light text-sm md:text-lg leading-relaxed max-w-3xl">
                    {step.text}
                  </p>
                </div>
              </div>

              {/* LA DIVISIÓN: Aparece después de cada paso menos el último */}
              {index < 4 && (
            <Separador />
              )}
            </>
          ))
        }
      </div>

      <div class="mt-32 flex justify-center lg:py-22" data-aos="zoom-in">
        <Link
          href="/contacto"
          class="bg-brand-coral hover:bg-brand-gray hover:text-brand-coral text-brand-gray p-4 md:px-8 py-5 rounded-lg font-bold font-title text-sm md:text-sm transition-all duration-300 shadow-xl shadow-brand-coral/20 hover:scale-105"
        >
          Construyamos tu marca
        </Link>
      </div>
    </div>
  </section>
</Layout>
