---
import Layout from "../layouts/Layout.astro";
import Separador from '../components/main/Separator.astro';
import iconoP from "../assets/iconos/posicionamiento.svg"; // Posicionamiento
import iconoC from "../assets/iconos/consultoria.svg"; // Consultoria
import iconoB from "../assets/iconos/branding.svg"; // Branding
import iconoW from "../assets/iconos/web.svg"; // Web
import Link from "../components/Link.astro";
---

<Layout
  title="Servicios | Smartketing"
  description="Elevamos tu marca con consultoría comercial, posicionamiento estratégico, branding visual y diseño web. Tu aliado creativo para vender mejor."
>
  <section
    class="relative w-full min-h-screen bg-transparent overflow-hidden pt-42 pb-20 px-6 lg:px-20"
  >
    <!-- <img
      src={background.src}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-top pointer-events-none"
    /> -->

    <div class="relative z-10 max-w-5xl mx-auto">
      <div class="text-center pt-15 md:-mb-16 lg:-mb-22" data-aos="fade-down">
        <h1 class="text-brand-gray text-3xl md:text-4xl font-light font-title">
          Nuestros <span class="text-brand-coral font-bold">Servicios</span>
        </h1>
      </div>

<Separador />

      <div class="flex flex-col">
        <article
          id="auditoria"
          class="scroll-mt-32 grid grid-cols-1 md:grid-cols-[320px_auto_320px] md:gap-x-4 items-start justify-center  rounded-4xl"
        >
          <div class="flex flex-col" data-aos="fade-right" data-aos-delay="200">
            <img
              src={iconoC.src}
              alt="Icono Auditoría"
              class="w-40 h-auto mb-5 scale-105"
            />

            <h2
              class="text-brand-cyan text-xl md:text-3xl font-title font-bold leading-[0.9] mb-10 tracking-tight"
            >
              Auditoría Comercial <br /> y de Ventas
            </h2>

            <div class="pr-2 py-6 flex flex-col font-body gap-3 text-[1.05rem] text-justify">
              <h3 class="text-white mb-5">Qué es</h3>
              <p
                class="text-brand-gray/90 leading-tight mb-8 font-extralight tracking-wide"
              >
                Un proceso de consultoría estratégica donde analizamos como
                vende hoy el negocio, identificamos bloqueos reales en su
                proceso comercial y ordenamos el punto de partida antes de
                comunicar o ejecutar.
              </p>
              <p
                class="text-brand-gray/90 leading-tight font-extralight tracking-wide"
              >
                Este servicio nos permite entender el negocio en profundidad y
                definir con criterio los siguientes pasos.
              </p>
            </div>
          </div>

          <div
            class="hidden md:block w-px bg-gray-700 self-stretch mt-32"
            data-aos="fade-in"
            data-aos-delay="500"
          >
          </div>

          <div
            class="mt-8 md:mt-32 pl-4 text-[1.05rem] font-body"
            data-aos="fade-left"
            data-aos-delay="400"
          >
            <h3 class="text-white mb-8">Incluye</h3>
            <ul
              class="space-y-7.5 text-brand-gray/90 font-extralight tracking-wide leading-[0.96]"
            >
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Reunión de diagnóstico
                estratégico
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Análisis del
                modelo de negocio y proceso de ventas
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Revisión del
                embudo comercial
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Auditoria del
                CRM (si aplica)
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Identificación
                de oportunidades y fugas de venta
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Informe estratégico
                con recomendaciones y roadmap de acción
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Este servicio
                es el primer paso para cualquier acompañamiento posterior.
              </li>
            </ul>
          </div>
        </article>

<Separador />

        <article
          id="posicionamiento"
          class="scroll-mt-0 grid grid-cols-1 md:grid-cols-[320px_auto_320px] md:gap-x-4 items-start justify-center -mt-20 md:-mt-25 rounded-4xl"
        >
          <div
            class="flex flex-col pt-25"
            data-aos="fade-right"
            data-aos-delay="200"
          >
            <img
              src={iconoP.src}
              alt="Icono Posicionamiento"
              class="w-40 h-auto scale-105"
            />

            <h2
              class="text-brand-cyan text-xl md:text-3xl font-title font-bold leading-[0.9] mb-10 tracking-tight"
            >
              Posicionamiento & Comunicación de Marca
            </h2>

            <div
              class="pr-2 pt-15 pb-6 flex flex-col font-body gap-3 text-[1.05rem] text-justify"
            >
              <h3 class="text-white mb-5">Qué es</h3>
              <p
                class="text-brand-gray/90 leading-tight font-extralight tracking-wide"
              >
                Un acompañamiento estratégico donde Smartketing actúa como el
                equipo creativo y de comunicación externo de la marca,
                trabajando sobre una dirección clara y coherente definida a
                partir del diagnóstico.
              </p>
            </div>
          </div>

          <div
            class="hidden md:block w-px bg-gray-700 self-stretch mt-32"
            data-aos="fade-in"
            data-aos-delay="500"
          >
          </div>

          <div
            class="mt-8 md:mt-32 pl-4 text-[1.05rem] font-body"
            data-aos="fade-left"
            data-aos-delay="400"
          >
            <h3 class="text-white mb-8">Incluye</h3>
            <ul
              class="space-y-6.5 text-brand-gray/90 font-extralight tracking-wide leading-[0.96]"
            >
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Dirección creativa
                de la marca.
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Generación de
                contenido de calidad (foto, video y storytelling). Creación de las
                ideas, coordinación, edición y publicación).
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Administración
                de redes sociales.
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Diseño gráfico
                continuo.
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Definición de
                narrativa, tono y mensajes.
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Consultoria
                en comunicación corporativa.
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Comunicación
                corporativa.
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Organización
                del ecosistema de marca (archivos, piezas y lineamientos).
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Coordinación
                de marketing con proveedores interno: imprenta.
              </li>
            </ul>
          </div>
        </article>

<Separador />

        <article
          id="branding"
          class="scroll-mt-10 grid grid-cols-1 md:grid-cols-[320px_auto_320px] md:gap-x-4 items-start justify-center -mt-12 md:-mt-20 rounded-4xl"
        >
          <div
            class="flex flex-col pt-10"
            data-aos="fade-right"
            data-aos-delay="200"
          >
            <img
              src={iconoB.src}
              alt="Icono Branding"
              class="w-40 h-auto scale-105"
            />

            <h2
              class="text-brand-cyan text-xl md:text-3xl font-title font-bold leading-[0.9] mb-10 tracking-tight"
            >
              Branding & <br /> Dirección Visual
            </h2>

            <div
              class="pr-2 pt-4 pb-6 flex flex-col font-body gap-3 text-[1.05rem] text-justify"
            >
              <h3 class="text-white mb-5">Qué es</h3>
              <p
                class="text-brand-gray/90 leading-tight font-extralight tracking-wide"
              >
                La construcción o evolución visual de una marca para que se vea
                profesional, clara y reconocible, manteniendo coherencia en
                todos sus puntos de contacto.
              </p>
            </div>
          </div>

          <div
            class="hidden md:block w-px bg-gray-700 self-stretch mt-32"
            data-aos="fade-in"
            data-aos-delay="500"
          >
          </div>

          <div
            class="mt-8 md:mt-32 pl-4 text-[1.05rem] font-body"
            data-aos="fade-left"
            data-aos-delay="400"
          >
            <h3 class="text-white mb-8">Incluye</h3>
            <ul
              class="space-y-7.5 text-brand-gray/90 font-extralight tracking-wide leading-[0.96]"
            >
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Diseño o rediseño
                de marca (logo)
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Desarrollo de
                identidad visual (colores, tipografías y estilo gráfico)
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Lineamientos
                de uso
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Aplicaciones
                básicas (redes sociales, piezas digitales, papelería)
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Dirección visual
                para asegurar coherencia en el tiempo
              </li>
            </ul>
          </div>
        </article>

<Separador />

        <article
          id="web"
          class="scroll-mt-32 grid grid-cols-1 md:grid-cols-[320px_auto_320px] md:gap-x-4 items-start justify-center -mt-12 md:-mt-20 rounded-4xl"
        >
          <div
            class="flex flex-col pt-10"
            data-aos="fade-right"
            data-aos-delay="200"
          >
            <img
              src={iconoW.src}
              alt="Icono Experiencia Digital de Marca"
              class="w-40 h-auto scale-105"
            />

            <h2
              class="text-brand-cyan text-xl md:text-3xl font-title font-bold leading-[0.9] mb-10 tracking-tight"
            >
              Experiencia Digital <br /> de Marca <br /><span
                class="text-brand-coral font-light text-xl leading-[0.9]"
              >
                (Diseño y desarrollo web – <br />proyecto puntual)
              </span>
            </h2>

            <div class="pr-2 pb-6 flex flex-col font-body gap-3 text-[1.05rem] text-justify">
              <h3 class="text-white mb-5">Qué es</h3>
              <p
                class="text-brand-gray/90 leading-tight font-extralight tracking-wide"
              >
                Diseño y desarrollo de páginas web alineadas al branding y al
                posicionamiento de la marca. No se trata solo de “hacer una
                web”, sino de construir una experiencia digital clara, funcional
                y coherente con la estrategia de marca.
              </p>
            </div>
          </div>

          <div
            class="hidden md:block w-px bg-gray-700 self-stretch mt-32"
            data-aos="fade-in"
            data-aos-delay="500"
          >
          </div>

          <div
            class="mt-8 md:mt-32 pl-4 text-[1.05rem] font-body"
            data-aos="fade-left"
            data-aos-delay="400"
          >
            <h3 class="text-white mb-8">Incluye</h3>
            <ul
              class="space-y-13 text-brand-gray/90 font-extralight tracking-wide leading-[0.96]"
            >
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Diseño web alineado
                a la identidad visual
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Desarrollo técnico
                del sitio
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Estructura clara
                de contenidos
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Optimización
                básica de experiencia de usuario
              </li>
              <li class="flex items-start">
                <span class="text-brand-gray mr-3 font-bold">•</span> Integración
                con herramientas necesarias (formularios, contacto, etc.)
              </li>
            </ul>
          </div>
        </article>
      </div>
    </div>
    <div
      class="w-full flex justify-center md:justify-center mt-16"
      data-aos="zoom-in-up"
      data-aos-delay="800"
    >
      <Link
        href="/contacto"
        class="bg-brand-coral hover:bg-brand-coral/90 text-sm italic text-white font-normal py-3 px-8 rounded-xl transition-all shadow-lg hover:scale-105 duration-300"
      >
        Conversemos sobre tu marca
      </Link>
    </div>
  </section>
  <script>
    function handleHashScroll() {
      const hash = window.location.hash;
      if (!hash) return;

      const element = document.querySelector(hash);
      if (!element) return;

      setTimeout(() => {
        const offset = 160;

        const y =
          element.getBoundingClientRect().top + window.pageYOffset - offset;

        window.scrollTo({
          top: y,
          behavior: "smooth",
        });

        element.classList.add("service-highlight");

        setTimeout(() => {
          element.classList.remove("service-highlight");
        }, 2000);
      }, 600);
    }

    window.addEventListener("load", handleHashScroll);
    document.addEventListener("astro:page-load", handleHashScroll);
  </script>
</Layout>
