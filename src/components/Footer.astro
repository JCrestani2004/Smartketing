---
// Componente Footer para Smartketing con gradiente
import logo from "../assets/logo_svg/logo.svg";
import { Icon } from 'astro-icon/components';
---

<footer
  class="relative w-full bg-linear-to-b from-brand-blue via-[#10247D] to-[#10247D] text-white pt-20 pb-10 px-6 lg:px-20 overflow-hidden -mt-1"
>
  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-20">
      <div class="flex flex-col gap-6">
        <h3
          class="hover:text-brand-coral text-xl font-bold font-title tracking-wider transition-all duration-300"
        >
          <a href="/servicio">Quiénes somos</a>
        </h3>
        <p
          class="text-gray-400 font-light font-body leading-relaxed text-sm max-w-xs"
        >
          Tenemos más de diez años acompañando a pequeñas y medianas empresas a
          construir marcas con criterio y visión a largo plazo.
        </p>
      </div>

      <div class="flex flex-col gap-6">
        <h3
          class="hover:text-brand-coral text-xl font-bold font-title tracking-wider transition-all duration-300"
        >
          <a href="/servicio">Servicios</a>
        </h3>
        <ul
          class="flex flex-col gap-3 text-gray-400 font-light font-body text-sm transition-all duration-300"
        >
          <li class="hover:text-brand-cyan transition-colors cursor-pointer">
            <a href="/servicio#auditoria">Consultoría comercial y de ventas</a>
          </li>
          <li class="hover:text-brand-cyan transition-colors cursor-pointer">
            <a href="/servicio#posicionamiento"
              >Posicionamiento & Comunicación de marca</a
            >
          </li>
          <li class="hover:text-brand-cyan transition-colors cursor-pointer">
            <a href="/servicio#branding">Branding y Dirección Visual</a>
          </li>
          <li class="hover:text-brand-cyan transition-colors cursor-pointer">
            <a href="/servicio#web">Experiencia Digital en Diseño Web</a>
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-6">
          <h3
            class="text-xl font-bold font-title tracking-wider hover:text-brand-coral transition-colors cursor-pointer  duration-300"
          >
            <a href="/equipo">Nuestro Equipo</a>
          </h3>
          <h3
            class="text-xl font-bold font-title tracking-wider hover:text-brand-coral transition-colors cursor-pointer  duration-300"
          >
            <a href="/contacto">Contáctanos</a>
          </h3>
        </div>
      </div>

      <div class="flex flex-col gap-8">
        <div>
          <h3
            class="text-sm font-bold font-subtitle tracking-[0.2em] mb-6 text-brand-gray"
          >
            Síguenos
          </h3>
          <div class="flex">
            <a
              href="https://instagram.com/smartketing360"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-xl flex items-center justify-center shadow-lg hover:scale-110 hover:bg-brand-cyan transition-all duration-300 group"
            >
              <Icon name="simple-icons:instagram" class="w-6 h-6" />
            </a>
          </div>
        </div>

        <a
          href="#"
          class="text-sm font-light font-subtitle text-brand-gray hover:text-brand-cyan transition-all duration-300"
        >
          Política de Privacidad
        </a>

        <a href="/" class="group">
          <img
            src={logo.src}
            alt="Smartketing Logo"
            class="h-15 w-auto object-contain group-hover:opacity-100 transition-opacity"
          />
        </a>
      </div>
    </div>

    <div
      class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-[11px] uppercase tracking-[0.3em] text-brand-gray/90 font-bold font-title"
    >
      <span>© 2026 SMARTKETING. TODOS LOS DERECHOS RESERVADOS.</span>
      <div class="flex gap-6">
        <span>ESTRATEGIA</span>
        <span class="text-brand-coral">DISEÑO</span>
        <span class="text-brand-cyan">CRITERIO</span>
      </div>
    </div>
  </div>
</footer>
