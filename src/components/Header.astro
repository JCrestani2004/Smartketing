---
import logo from "../assets/logo_svg/logo.svg";
---

<nav id="main-nav" class="fixed top-0 w-full z-100 bg-transparent font-body transition-all duration-300">
  <div class="max-w-8xl mx-auto px-6 md:px-20 lg:px-25 py-6 flex justify-between items-center">

    <a href="/">
      <img src={logo.src} alt="Smartketing" class="h-10 md:h-13 transition-transform duration-300 hover:scale-105" />
    </a>

    <ul class="hidden md:flex gap-14 md:text-xs lg:text-base text-brand-gray font-extralight">
        <li><a href="/about" class="hover:text-brand-cyan transition-colors duration-500">Quiénes somos</a></li>
        <li><a href="/servicio" class="hover:text-brand-cyan transition-colors duration-500">Servicio</a></li>
      <li><a href="/equipo" class="hover:text-brand-cyan transition-colors duration-500">Equipo</a></li>
      <li><a href="/contacto" class="hover:text-brand-cyan transition-colors duration-500">Contáctenos</a></li>
    </ul>

    <button id="menu-btn" class="md:hidden z-101 flex flex-col gap-1.5 pointer-events-auto">
      <span class="w-8 h-0.5 bg-brand-gray transition-all origin-center"></span>
      <span class="w-8 h-0.5 bg-brand-gray transition-all"></span>
      <span class="w-8 h-0.5 bg-brand-gray transition-all origin-center"></span>
    </button>

    <div id="mobile-menu" class="fixed top-0 left-0 w-full h-screen z-100 bg-brand-blue/95 backdrop-blur-md flex flex-col items-center justify-center gap-8 translate-x-full transition-transform duration-500 md:hidden">
      <a href="/">
      <img src={logo.src} alt="Smartketing" class="h-20 md:h-24 transition-transform duration-300 hover:scale-105 mb-8" />
    </a>
      <a href="/about" class="text-2xl text-white font-light hover:text-brand-cyan">Quiénes somos</a>
      <a href="/servicio" class="text-2xl text-white font-light hover:text-brand-cyan">Servicio</a>
      <a href="/equipo" class="text-2xl text-white font-light hover:text-brand-cyan">Equipo</a>
      <a href="/contacto" class="text-2xl text-white font-light hover:text-brand-cyan">Contáctenos</a>
    </div>

  </div>
</nav>

<style>
  /* Animación de la Hamburguesa */
  #menu-btn.open span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #menu-btn.open span:nth-child(2) {
    opacity: 0;
  }
  #menu-btn.open span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Corrección para Nav Scrolled en Tailwind v4 */
  .nav-scrolled {
    /* Si el error persiste con @apply, usa clases estándar o CSS puro */
    background-color: rgba(37, 26, 130, 0.9); /* Esto es #251A82 al 90% */
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {

    const nav = document.getElementById('main-nav');
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const links = mobileMenu?.querySelectorAll('a');

    // Scroll effect
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav?.classList.add('nav-scrolled');
      } else {
        nav?.classList.remove('nav-scrolled');
      }
    });

    // Toggle menu
    menuBtn?.addEventListener('click', () => {
      const isOpened = menuBtn.classList.toggle('open');
      mobileMenu?.classList.toggle('translate-x-full');

      if (isOpened) {
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      } else {
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }
    });

    // Close menu on link click
    links?.forEach(link => {
      link.addEventListener('click', () => {
        menuBtn?.classList.remove('open');
        mobileMenu?.classList.add('translate-x-full');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      });
    });

  });
</script>