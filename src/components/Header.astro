---
import logo from "../assets/brandoors/logo.svg";
import Link from "../components/Link.astro";
---

<nav id="main-nav" class="fixed top-0 w-full z-100 bg-transparent font-body transition-all duration-300">
  <div class="max-w-8xl mx-auto px-6 md:px-15 lg:px-20 py-6 flex justify-between items-center gap-5">

    <Link href="/"
    data-aos="fade-right" 
        data-aos-duration="1000">
      <img src={logo.src} alt="Brandoors" class="h-10 md:h-13 transition-transform duration-300 hover:scale-105" 
      />
    </Link>

    <ul class="hidden lg:flex gap-14 md:text-xs lg:text-base text-brand-gray font-extralight">
        <li><Link href="/" class="nav-link hover:text-white transition-all duration-300"
          data-aos="fade-down" data-aos-delay="100"
          >Inicio</Link></li>
        <li><Link href="/about" class="nav-link hover:text-white transition-all duration-300"
          data-aos="fade-down" data-aos-delay="100"
          >Quiénes somos</Link></li>
        <li><Link href="/servicio" class="nav-link hover:text-white transition-all duration-300"
          data-aos="fade-down" data-aos-delay="200">Servicios
        </Link></li>
      <li><Link href="/equipo" class="nav-link hover:text-white transition-all duration-300"
        data-aos="fade-down" data-aos-delay="300"
        >Equipo</Link></li>
      <li><Link href="/contacto" class="nav-link hover:text-white transition-all duration-300"
        data-aos="fade-down" data-aos-delay="400"
        >Contáctenos</Link></li>
    </ul>

    <button id="menu-btn" class="lg:hidden z-101 flex flex-col gap-1.5 pointer-events-auto">
      <span class="w-8 h-0.5 bg-brand-gray transition-all origin-center"></span>
      <span class="w-8 h-0.5 bg-brand-gray transition-all"></span>
      <span class="w-8 h-0.5 bg-brand-gray transition-all origin-center"></span>
    </button>

    <div id="mobile-menu" class="fixed top-0 left-0 w-full h-screen z-100 bg-brand-blue/95 backdrop-blur-md flex flex-col items-center justify-center gap-8 translate-x-full transition-transform duration-500 lg:hidden">
      <Link href="/">
      <img src={logo.src} alt="Brandoors" class="h-20 md:h-24 transition-transform duration-300 hover:scale-105 mb-8" />
    </Link>
      <Link href="/" class="text-2xl text-white font-light hover:text-brand-cyan">Inicio</Link>
      <Link href="/about" class="text-2xl text-white font-light hover:text-brand-cyan">Quiénes somos</Link>
      <Link href="/servicio" class="text-2xl text-white font-light hover:text-brand-cyan">Servicios</Link>
      <Link href="/equipo" class="text-2xl text-white font-light hover:text-brand-cyan">Equipo</Link>
      <Link href="/contacto" class="text-2xl text-white font-light hover:text-brand-cyan">Contáctenos</Link>
    </div>

  </div>
</nav>

<style>
  /* Animación de la Hamburguesa */
  #menu-btn.open span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #menu-btn.open span:nth-child(2) {
    opacity: 0;
  }
  #menu-btn.open span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Corrección para Nav Scrolled en Tailwind v4 */
  .nav-scrolled {
    /* Si el error persiste con @apply, usa clases estándar o CSS puro */
   background: rgba(11, 20, 55, 0.8); /* Azul del formulario */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(34, 211, 255)
    padding-top: 0.75rem !important;
    padding-bottom: 0.75rem !important;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.3);
  }

  /* Estilo base para el enlace */
  .nav-link {
    position: relative;
    display: inline-block;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  /* Efecto de crecimiento del texto */
  .nav-link:hover {
    transform: scale(1.1); /* Crece un 10% */
  }

  /* Creación de la línea gradiente */
  .nav-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: -6px; /* Espacio bajo el texto */
    left: 50%;
    /* Gradiente con tus colores de marca */
    background: linear-gradient(90deg, #00C2FF 0%, #FF6B6B 100%);
    transition: width 0.4s ease, left 0.4s ease;
    border-radius: 2px;
  }

  /* Animación de la línea al hacer hover */
  .nav-link:hover::after {
    width: 100%;
    left: 0;
  }

  /* --- Tus estilos anteriores (nav-scrolled, etc.) --- */
  .nav-scrolled {
    background-color: transparent;
    backdrop-filter: blur(10px);
  }

  .nav-about-style {
    background-color: rgba(39, 52, 139, 0.3);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0, 194, 255, 0.7);
  }

</style>

<script>
  document.addEventListener("astro:page-load", () => {

    const nav = document.getElementById('main-nav');
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const links = mobileMenu?.querySelectorAll('a');

    // Scroll effect
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav?.classList.add('nav-scrolled');
      } else {
        nav?.classList.remove('nav-scrolled');
      }
    });

    // Toggle menu
    menuBtn?.addEventListener('click', () => {
      const isOpened = menuBtn.classList.toggle('open');
      mobileMenu?.classList.toggle('translate-x-full');

      if (isOpened) {
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      } else {
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }
    });

    // Close menu on link click
    links?.forEach(link => {
      link.addEventListener('click', () => {
        menuBtn?.classList.remove('open');
        mobileMenu?.classList.add('translate-x-full');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      });
    });

  });
</script>