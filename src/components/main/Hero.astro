---
import heroFondo from "../../assets/background/BackgroundHero.svg";
import onda from "../../assets/assets/onda1.svg";
import iconoP from "../../assets/iconos/posicionamiento.svg";
import iconoH from "../../assets/iconos/icono-hero.svg";
import Link from "../Link.astro";
---

<section
  class="relative w-full min-h-screen xl:min-h-[135vh] flex flex-col lg:block overflow-x-clip"
>
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src={heroFondo.src}
      alt="Background Hero"
      class="w-full h-full object-cover object-bottom lg:object-top scale-105 lg:-translate-y-1"
    />
  </div>

  <div
    class="relative z-20 max-w-8xl mx-auto px-3 lg:px-12 flex flex-col pt-[25vh] md:pt-[30vh] lg:pt-[36vh] items-center"
  >
    <div
      class="flex flex-col lg:flex-row justify-center lg:gap-x-12 xl:gap-x-20 items-center w-full max-w-250 relative"
    >
      <img
        src={onda.src}
        alt=""
        class="absolute -z-10 w-[250%] max-w-none lg:w-[130%] top-[20%] left-[62%] lg:top-1/2 lg:left-1/2 -translate-x-[55%] lg:-translate-x-[60%] -translate-y-1/2 pointer-events-none"
        data-aos="zoom-out" data-aos-delay="200" data-aos-duration="2000"
      />

      <div
        class="text-center lg:text-left lg:items-start xl:pl-10 lg:pb-8 xl:pb-12"
      >
        <h1
          class="font-title text-[2.5rem] leading-[0.9] lg:text-[3.8rem] text-white"
        >
          <span class="block font-light tracking-tight"
          data-aos="fade-up" data-aos-delay="400"
          >ESTUDIO DE</span>
          <span class="block font-bold text-brand-cyan uppercase"
          data-aos="fade-up" data-aos-delay="600"
            >comunicación</span
          >
          <span class="block italic text-brand-coral uppercase"
          data-aos="fade-up" data-aos-delay="800"
          >creativa</span>
        </h1>

        <div
          class="flex items-center justify-center lg:justify-start max-w-full lg:max-w-220 mt-8 lg:mt-3"
        >
          <img
            src={iconoP.src}
            alt=""
            class="w-16 lg:w-25 lg:translate-y-2"
            data-aos="fade-right" data-aos-delay="1000"
          />
          <p
            class="text-brand-gray/90 font-subtitle text-[1.1rem] lg:text-[1.3rem] font-extralight leading-tight lg:leading-[0.8] text-left"
            data-aos="fade-right" data-aos-delay="1000"
          >
            <span class="opacity-90">Para marcas</span>
            <br />
            <span class="font-medium">en crecimiento</span>
          </p>
        </div>
      </div>

      <div
        class="relative flex flex-col items-center lg:items-end gap-10 lg:gap-0 lg:pb-18 mt-5 lg:mt-0"
      >
        <img
          src={iconoH.src}
          alt="Impulso"
          class="w-28 lg:w-32 mb-4
           lg:absolute
           lg:-top-12 lg:left-26
           z-30 animate-pulse"
           data-aos="zoom-in" data-aos-delay="1200"
        />

        <div class="lg:mt-32">
          <Link
            href="/contacto"
            class="font-body bg-brand-cyan text-brand-blue px-8 py-3 lg:px-4 lg:py-3 rounded-xl font-bold text-[1.02rem] hover:bg-brand-purple transition active:scale-95 shadow-lg"
            data-aos="fade-up" data-aos-delay="1000"
          >
            Agenda una llamada
          </Link>
        </div>
      </div>
    </div>
  </div>

  <h2
    class="w-full text-center lg:w-auto lg:absolute lg:right-36 xl:right-50 lg:bottom-10 font-body text-sm lg:text-base xl:text-lg z-20 text-white font-light antialiased tracking-widest mt-3 md:mt-auto pb-30 lg:pb-0"
    data-aos="fade-in" data-aos-delay="1100"
  >
    Confiaron en nosotros
  </h2>
</section>
