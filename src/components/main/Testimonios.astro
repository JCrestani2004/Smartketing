---
// Definicion de imagenes
import background from '../../assets/background/backgroundst.webp';
import Separador from './Separator.astro';
import damaschke from '../../assets/clientes/damaschke.svg';
import energy from '../../assets/clientes/energy.svg';
import simel from '../../assets/clientes/simel.svg';
import hunter from '../../assets/clientes/hunter.svg';
import onda from '../../assets/assets/onda_clientes.svg'

// Lista de Testimonios
const testimonios = [
  {
    id: "damaschke",
    logo: damaschke,
    alt: "Damaschke Premium Line",
    texto:
      "Más allá de los números, valoramos la comunicación fluida, la escucha activa y la capacidad para adaptarse a nuestras necesidades. Son, sin duda, un aliado estratégico de confianza.",
  },
  {
    id: "energy",
    logo: energy,
    alt: "Energy Control",
    texto:
      "Su equipo ha asumido con excelencia la gestión de nuestras redes sociales y campañas. Nos gusta la pronta atención y respuesta a nuestros requerimientos, eso es importante.",
  },
  {
    id: "simel",
    logo: simel,
    alt: "Simel Panama",
    texto:
      "Smartketing ha sido clave en nuestro crecimiento, gestionando con excelencia nuestras redes sociales, estrategias de marketing y campañas pagadas con contenido creativo, siempre con una atención valiosa y constante.",
  },
  {
    id: "hunter",
    logo: hunter,
    alt: "Hunter Panama",
    texto:
      "El profesionalismo, proactividad y calidad del servicio que ofrece Smarketing ha superado nuestras expectativas de manera constante. Recomendamos plenamente sus servicios.",
  },
];
const tripleTestimonios = [...testimonios, ...testimonios, ...testimonios];
---

<section
  class="relative w-full bg-transparent pb-8 pt-12 lg:pt-0 mt-16 overflow-hidden"
>
  <!-- <img
    src={background.src}
    alt="Fondo de clientes"
    class="absolute inset-0 w-full h-full object-cover object-bottom z-0 pointer-events-none scale-110"
  /> -->
  <!-- <div
    class="absolute w-full flex justify-center pointer-events-none select-none -mt-25 z-50"
  >
    <img
      src={division.src}
      alt=""
      class="w-full max-w-5xl h-auto mix-blend-screen"
      data-aos="zoom-in"
      data-aos-delay="200"
    />
  </div> -->
      <h2
    class="w-full text-center font-title  text-4xl md:text-[2.73rem] z-20 text-white font-bold mt-3 md:mt-auto pb-30 lg:pb-0 2xl:pb-8 2xl:text-4xl"
    
  >
    <span class="text-brand-cyan font-bold">Testi</span>monios
  </h2>

  <div
    class="relative w-full max-w-7xl mx-auto px-6 lg:px-10 grid grid-cols-1 lg:grid-cols-12 gap-0 lg:gap-10 items-center z-10"
  >
    <div
      class="lg:col-span-4 flex flex-col items-center relative h-20 md:h-24 lg:h-90 lg:overflow-hidden"
    >
      <div
        id="logo-track"
        class="flex flex-row lg:flex-col items-center transition-transform duration-700 ease-in-out pt-10 lg:pt-0"
        data-aos="fade-right"
        data-aos-delay="400"
      >
        {
          tripleTestimonios.map((item, index) => (
            <div
              class="logo-item cursor-pointer flex items-center justify-center shrink-0 w-full lg:w-full h-full md:h-20 lg:h-30"
              data-index={index % testimonios.length}
              data-texto={item.texto}
            >
              <img
                src={item.logo.src}
                alt={item.alt}
                class="z-10 w-30 md:w-38 lg:w-40 object-contain pointer-events-none grayscale scale-75 lg:scale-90 transition-all duration-500"
              />
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="lg:col-span-8 relative flex items-center justify-center w-full min-h-112.5 md:min-h-137.5 lg:min-h-162.5"
    >
      <img
        src={onda.src}
        alt="Marco de testimonio"
        class="absolute inset-0 w-full h-full object-contain z-0 scale-[1.9] md:scale-[1.5] lg:scale-130"
        data-aos="zoom-out"
        data-aos-duration="1500"
        data-aos-delay="600"
      />

      <div
        class="relative z-10 w-full max-w-lg px-16 md:px-24 lg:px-24 flex items-center justify-center -mt-12 lg:mt-0 lg:pb-13"
      >
        <p
          id="testimonial-text"
          class="text-brand-gray/90 text-[10px] min-[375px]:text-[0.7] text-sm md:text-sm lg:text-lg font-extralight italic text-center transition-all duration-500 tracking-tight leading-relaxed lg:leading-tight"
        >
        </p>
      </div>
    </div>
  </div>

  <Separador />
</section>

<style>
  #logo-track {
    will-change: transform;
  }
  /* En móvil, los items deben tener un ancho definido para que el desplazamiento funcione */
  @media (max-width: 1023px) {
    .logo-item {
      width: 100%; /* Cada logo ocupa el ancho del contenedor visible */
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const track = document.getElementById("logo-track");
    const textElement = document.getElementById("testimonial-text");
    const logos = document.querySelectorAll(".logo-item");

    let currentIndex = 0;
    const itemHeight = 120; // Altura en Desktop
    let autoPlayInterval;
    const intervalTime = 5000;

    const updateCarousel = (index) => {
      const isMobile = window.innerWidth < 1024;

      if (track) {
        if (isMobile) {
          // Desplazamiento Horizontal en Móvil
          const container = track.parentElement;
          const itemWidth = container.offsetWidth;
          track.style.transform = `translateX(-${index * itemWidth}px)`;
        } else {
          // Desplazamiento Vertical en Desktop
          track.style.transform = `translateY(-${index * itemHeight}px)`;
        }
      }

      logos.forEach((logo, i) => {
        const img = logo.querySelector("img");
        if (img) {
          if (i === index) {
            img.classList.remove("opacity-30", "grayscale", "scale-90");
            img.classList.add("opacity-100", "grayscale-0", "scale-110");
          } else {
            img.classList.remove("opacity-100", "grayscale-0", "scale-110");
            img.classList.add("opacity-30", "grayscale", "scale-90");
          }
        }
      });

      const nuevoTexto = logos[index].getAttribute("data-texto");
      if (textElement) {
        textElement.style.opacity = "0";
        textElement.style.transform = "translateY(10px)";

        setTimeout(() => {
          textElement.textContent = `"${nuevoTexto}"`;
          textElement.style.opacity = "1";
          textElement.style.transform = "translateY(0)";
          if (window.AOS) {
            (window as any).AOS?.refresh();;
          }
        }, 300);
      }
    };

    const nextSlide = () => {
      currentIndex = (currentIndex + 1) % logos.length;
      updateCarousel(currentIndex);
    };

    const startAutoPlay = () => {
      autoPlayInterval = setInterval(nextSlide, intervalTime);
    };

    const resetAutoPlay = () => {
      clearInterval(autoPlayInterval);
      startAutoPlay();
    };

    logos.forEach((logo) => {
      logo.addEventListener("click", () => {
        currentIndex = parseInt(logo.getAttribute("data-index"));
        updateCarousel(currentIndex);
        resetAutoPlay();
      });
    });

    // Recalcular en caso de cambio de orientación o tamaño de ventana
    window.addEventListener("resize", () => updateCarousel(currentIndex));

    updateCarousel(0);
    startAutoPlay();
    // Dentro de tu script, añade esto para el resize
    window.addEventListener("resize", () => {
      // Forzamos un pequeño retraso para que el navegador recalcule el layout
      setTimeout(() => {
        updateCarousel(currentIndex);
      }, 100);
    });
  });
</script>
