---
/* Seccion Confiaron en Nosotros */
const backgroundImage = '/background/Bannerlogos.svg';
const clients = [
    { name: 'MiamiFoodTrucksEvents', logo: '/clientes/miami.svg' },
    { name: 'Energy Control', logo: '/clientes/energy.svg' },
    { name: 'Gel Smart', logo: '/clientes/gel.svg' },
    { name: 'Illuminations', logo: '/clientes/illuminations.svg' },
    { name: 'Osumed', logo: '/clientes/osumed.svg' },
    { name: 'Simel', logo: '/clientes/simel.svg' },
    { name: 'Vicone', logo: '/clientes/vicone.svg' },
    { name: 'Damaschke', logo: '/clientes/damaschke.svg' },
    { name: 'Hunter', logo: '/clientes/hunter.svg' },
    { name: 'Epcom', logo: '/clientes/epcom.svg' }
];
const doubleClients = [...clients, ...clients];
---

<section class="relative w-full overflow-hidden py-8 lg:py-16 z-30 -mt-22 lg:-mt-16 overflow-x-clip">
  <div class="absolute inset-0 -z-10 w-full">
    <img
      src={backgroundImage}
      alt="Fondo decorativo"
      class="h-full w-full scale-110 object-cover object-left lg:object-top-right"
    />
  </div>

  <div class="relative flex items-center overflow-hidden max-w-[100vw]">
    <div class="flex w-max animate-marquee items-center gap-8 md:gap-16">
      {doubleClients.map((client) => (
        <img 
          src={client.logo} 
          alt={client.name} 
          class="h-8 md:h-14 w-auto object-contain brightness-0 invert px-2 lg:mt-4"
        />
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .animate-marquee {
    display: flex;
    white-space: nowrap;
    animation: marquee 25s linear infinite; /* Un poco más rápido para compensar el gap menor */
  }

  /* Pausar al pasar el mouse */
  .animate-marquee:hover {
    animation-play-state: paused;
  }

  /* Evita saltos visuales en móviles */
  @media (max-width: 768px) {
    .animate-marquee {
      animation-duration: 20s;
    }
  }
</style>