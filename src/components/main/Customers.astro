---
import backgroundImage from '../../assets/background/Bannerlogos.svg';
import miami from '../../assets/clientes/miami.svg';
import energy from '../../assets/clientes/energy.svg';
import gel from '../../assets/clientes/gel.svg';
import illuminations from '../../assets/clientes/illuminations.svg';
import osumed from '../../assets/clientes/osumed.svg';
import simel from '../../assets/clientes/simel.svg';
import vicone from '../../assets/clientes/vicone.svg';
import damaschke from '../../assets/clientes/damaschke.svg';
import hunter from '../../assets/clientes/hunter.svg';
import luxolar from '../../assets/clientes/luxolar.svg';
import epcom from '../../assets/clientes/epcom.svg';
/* Seccion Confiaron en Nosotros */

const clients = [
    { name: 'MiamiFoodTrucksEvents', logo: miami },
    { name: 'Energy Control', logo: energy },
    { name: 'Gel Smart', logo: gel },
    { name: 'Illuminations', logo: illuminations },
    { name: 'Osumed', logo: osumed },
    { name: 'Simel', logo: simel },
    { name: 'Vicone', logo: vicone },
    { name: 'Damaschke', logo: damaschke },
    { name: 'Hunter', logo: hunter },
    { name: 'Luxolar', logo: luxolar },
    { name: 'Epcom', logo: epcom }
];
const doubleClients = [...clients, ...clients];
---

<section class="relative w-full overflow-hidden py-8 lg:py-16 z-30 -mt-22 lg:-mt-16 overflow-x-clip"
data-aos="fade-up" data-aos-duration="200" data-aos-delay="600"
>
  <div class="absolute inset-0 -z-10 w-full">
    <img
      src={backgroundImage.src}
      alt="Fondo decorativo"
      class="h-full w-full scale-110 object-cover object-left lg:object-top-right"
      data-aos="zoom-out" data-aos-duration="200" data-aos-delay="600"
    />
  </div>

  <div class="relative flex items-center overflow-hidden max-w-[100vw]">
    <div class="flex w-max animate-marquee items-center gap-8 md:gap-16 transition:persist">
      {doubleClients.map((client) => (
        <img 
          src={client.logo.src} 
          alt={client.name} 
          class="h-8 md:h-14 w-auto object-contain brightness-0 invert px-2 lg:mt-4"
        />
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .animate-marquee {
    display: flex;
    white-space: nowrap;
    animation: marquee 25s linear infinite; /* Un poco más rápido para compensar el gap menor */
  }

  /* Pausar al pasar el mouse */
  .animate-marquee:hover {
    animation-play-state: paused;
  }

  /* Añade esto a tu etiqueta img dentro del map */
.animate-marquee img {
  transition: all 0.4s ease;
  filter: brightness(0) invert(1) opacity(0.7); /* Logos un poco más tenues por defecto */
}

.animate-marquee img:hover {
  filter: brightness(0) invert(1) opacity(1); /* Resaltan al pasar el mouse */
  scale: 1.1;
}

  /* Evita saltos visuales en móviles */
  @media (max-width: 768px) {
    .animate-marquee {
      animation-duration: 20s;
    }
  }
</style>