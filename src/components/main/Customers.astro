---
import backgroundImage from '../../assets/background/Bannerlogos.svg';
import Separador from './Separator.astro';
import miami from '../../assets/clientes/miami.svg';
import energy from '../../assets/clientes/energy.svg';
import gel from '../../assets/clientes/gel.svg';
import illuminations from '../../assets/clientes/illuminations.svg';
import osumed from '../../assets/clientes/osumed.svg';
import simel from '../../assets/clientes/simel.svg';
import vicone from '../../assets/clientes/vicone.svg';
import damaschke from '../../assets/clientes/damaschke.svg';
import hunter from '../../assets/clientes/hunter.svg';
import luxolar from '../../assets/clientes/luxolar.svg';
import epcom from '../../assets/clientes/epcom.svg';
/* Seccion Confiaron en Nosotros */

const clients = [
    { name: 'MiamiFoodTrucksEvents', logo: miami, scale: "scale-100" },
    { name: 'Energy Control', logo: energy, scale: "scale-140" },
    { name: 'Gel Smart', logo: gel, scale: "scale-130" },
    { name: 'Illuminations', logo: illuminations, scale: "scale-200" },
    { name: 'Osumed', logo: osumed, scale: "scale-85" },
    { name: 'Simel', logo: simel, scale: "scale-100" },
    { name: 'Vicone', logo: vicone, scale: "scale-120" },
    { name: 'Damaschke', logo: damaschke, scale: "scale-140" },
    { name: 'Hunter', logo: hunter, scale: "scale-100" },
    { name: 'Luxolar', logo: luxolar, scale: "scale-120" },
    { name: 'Epcom', logo: epcom, scale: "scale-120" }
];
const doubleClients = [...clients, ...clients];
---

<section class="relative w-full py-8 lg:py-16 z-30 -mt-10 lg:-mt-16 2xl:-mt-25 overflow-x-clip"
data-aos="fade-in" data-aos-delay="600"
>
  <!-- <div class="absolute inset-0 -z-10 w-full">
    <img
      src={backgroundImage.src}
      alt="Fondo decorativo"
      class="h-full w-full scale-110 object-cover object-left lg:object-top-right"
    />
  </div> -->
    <h2
    class="w-full text-center font-title text-2xl xl:text-4xl z-20 text-white font-light antialiased tracking-widest mt-3 md:mt-auto pb-30 lg:pb-0 2xl:pb-8 2xl:text-4xl"
    
  >
    <span class="text-brand-cyan font-bold">Algunos</span> de nuestros clientes
  </h2>
  <div class="logo-marquee relative mx-auto flex items-center overflow-hidden w-full max-w-4xl">
    <div class="flex w-max animate-marquee items-center gap-8 md:gap-16 transition:persist">
      {doubleClients.map((client) => (
        <div class="felx-shrink-0 flex items-center justify-center h-24 md:h-32 w-24 md:w-32 py-2">
        <img 
          src={client.logo.src} 
          alt={client.name} 
          class={`max-h-full max-w-full object-contain brightness-0 invert px-2 lg:mt-4 2xl:mt-8 ${client.scale}`}
        />
        </div>
      ))}
    </div>
  </div>

  <Separador />
</section>

<style>
 
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* Mueve exactamente la mitad del contenido duplicado */
  }

  .animate-marquee {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite; /* Aumenté el tiempo para más suavidad */
  }

  /* Optimización para evitar tirones de GPU */
  .will-change-transform {
    will-change: transform;
  }

  .animate-marquee:hover {
    animation-play-state: paused;
  }

  /* Tu máscara de desvanecimiento está perfecta */
  .logo-marquee {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 15%,
      black 85%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 15%,
      black 85%,
      transparent
    );
  }

  /* Ajuste de ancho para que no se vea cortado si el contenido es poco */
  .logo-marquee {
    max-width: 60%; /* Ajusta según tu diseño, pero evita que sea muy pequeño */
  }
</style>
