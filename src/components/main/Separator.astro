---
 // Separador de secciones
 import division from "../../assets/assets/division-01.svg";
---

<div class="absolute bottom-0 left-0 w-full translate-y-1/2 z-[80] pointer-events-none"
data-aos="fade"
  data-aos-duration="1500"
  data-aos-delay="500"
  data-aos-once="true"
  >
  <img 
    src={division.src} 
    class="w-full h-auto object-cover opacity-80 blur-[2px] contrast-125" 
    alt="" 
    style="filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.7));"
  />
</div>