---
// components/ModalEquipo.astro
import iluminacion from "../../assets/assets/iluminacion-perfil.svg";
---

<div id="team-modal" class="fixed inset-0 z-[110] flex items-center justify-center hidden opacity-0 transition-all duration-500 p-4">
  <div class="absolute inset-0 bg-black/80 backdrop-blur-xl" id="modal-overlay"></div>

  <div class="relative w-[95%] max-w-5xl h-[85vh] md:h-137.5 bg-white/10 backdrop-blur-3xl border border-white/20 rounded-[2.5rem] overflow-hidden shadow-2xl flex flex-col md:flex-row transform scale-95 transition-transform duration-500" id="modal-content">
    
    <button id="close-modal" class="absolute top-6 right-6 z-120 text-white/50 hover:text-brand-coral transition-colors p-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="w-full md:w-5/12 h-[40%] md:h-full relative bg-white/5 flex items-end justify-center overflow-hidden shrink-0">
      <img src={iluminacion.src} class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-40" />
      <img id="modal-img" src="" alt="" class="relative z-10 w-full h-full object-contain object-bottom" />
    </div>

    <div class="w-full md:w-7/12 h-[60%] md:h-full p-6 md:p-14 flex flex-col">
      <div class="mb-4 shrink-0">
        <h2 class="font-title text-2xl md:text-5xl leading-tight mb-1">
          <span id="modal-nombre" class="text-brand-coral font-bold block"></span>
          <span id="modal-apellido" class="text-white font-extralight block"></span>
        </h2>
        <p id="modal-cargo" class="text-brand-cyan font-body font-medium text-[10px] md:text-sm uppercase tracking-[0.2em]"></p>
      </div>
      
      <div id="modal-bio" class="text-brand-gray/90 font-body font-light text-sm md:text-base leading-relaxed overflow-y-auto pr-4 custom-scrollbar text-justify flex-1 pb-4">
      </div>
    </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #ff5e5e; border-radius: 10px; }
</style>