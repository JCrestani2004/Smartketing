---
interface Props {
  imagenes: string[];
}

const { imagenes } = Astro.props;
---

<section class="max-w-4xl mx-auto px-6 py-4" data-motion="revealUp">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3">
    {imagenes.map((img) => (
      <div class="w-full aspect-auto overflow-hidden shadow-xl group">
        <img 
          src={img} 
          alt="Detalle del caso de éxito" 
          class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-103"
          loading="lazy"
        />
      </div>
    ))}
  </div>
</section>