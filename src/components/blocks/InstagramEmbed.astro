---
interface Props {
  urls: string[];
}

const { urls } = Astro.props;
---

<section class="max-w-4xl mx-auto px-6 py-4" data-motion="revealUp">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 justify-center">
    {urls.map((url) => {
      // Formateo limpio para asegurar el render nativo del iframe de IG
      const embedUrl = url.endsWith('/') ? `${url}embed/` : `${url}/embed/`;
      
      return (
        <div class="w-full aspect-9/16 relative overflow-hidden bg-transparent">
          <iframe 
            src={embedUrl} 
            class="absolute left-0 w-full h-[110%] bottom-[-14%] border-0 pointer-events-none" 
            scrolling="no" 
            allowtransparency="true"
          />
        </div>
      );
    })}
  </div>
</section>