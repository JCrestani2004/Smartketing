---
interface Props {
  urls: string[];
}

const { urls } = Astro.props;
---

<section class="max-w-4xl mx-auto px-6 py-8" data-motion="revealUp">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 justify-center">
    {urls.map((url) => {
      // Formateo limpio para asegurar el render nativo del iframe de IG
      const embedUrl = url.endsWith('/') ? `${url}embed/` : `${url}/embed/`;
      
      return (
        <div class="w-full h-140 overflow-hidden shadow-2xl">
          <iframe 
            src={embedUrl} 
            class="w-full h-full border-0" 
            scrolling="no" 
            allowtransparency="true"
          />
        </div>
      );
    })}
  </div>
</section>