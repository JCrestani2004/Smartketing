---
interface Metrica {
  numero: string;
  etiqueta: string;
  descripcion: string;
}

interface Props {
  tituloSeccion?: string;
  metricas: Metrica[];
}

const { tituloSeccion, metricas } = Astro.props;
---

<section class="max-w-4xl mx-auto px-6 py-8 space-y-12" data-aos="fade-up">
  {
    tituloSeccion && (
      <h3 class="text-xl font-semibold tracking-widest text-brand-gray uppercase">
        {tituloSeccion}
      </h3>
    )
  }

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
    {
      metricas.map((item) => (
        <div class="border-t border-brand-coral pt-6 group/item">
          <span class="text-xl xl:text-2xl font-bold text-white tracking-tight block transition-colors duration-300 group-hover/item:text-zinc-300">
            {item.numero}
          </span>
          <div class="flex flex-col justify-between h-30 gap-2 pt-4">
            <h4 class="text-xs font-semibold text-brand-gray uppercase tracking-wider">
              {item.etiqueta}
            </h4>
            <p class="text-sm text-brand-gray/80 leading-relaxed">
              {item.descripcion}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
