---
import "../styles/global.css";
const { title = "Smartketing", description = "Tu agencia de comunicación creativa para marcas en crecimiento." } = Astro.props;
import fav from "../assets/smart/smart-simbolo.svg"
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={fav.src} />
    <link rel="icon" href={fav.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <ClientRouter />
  <body class="bg-brand-gray/85">
    <Header />
    <slot />
    <Footer />
  </body>
 <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>

<script is:inline>
  // 1. Definimos la función de inicialización
  function initAOS() {
    AOS.init({
      duration: 1000,
      once: true,
      offset: 100,
    });
  }

  // 2. La ejecutamos cuando carga la página por primera vez
  initAOS();

  // 3. ¡ESTA ES LA CLAVE! 
  // Cada vez que Astro cambia de página (evento astro:after-swap), 
  // le decimos a AOS que refresque y vuelva a buscar elementos.
  document.addEventListener('astro:after-swap', () => {
    AOS.refresh(); // Despierta a AOS
    initAOS();     // Reinicia la configuración
  });
</script>
<script>
  document.addEventListener("astro:page-load", () => {
    const params = new URLSearchParams(window.location.search);
    const status = params.get("status");

    if (status === "success") {
      showSmartAlert(
        "¡Gracias por escribirnos!", 
        "Recibimos tu mensaje y muy pronto estaremos en contacto contigo.", 
        "success"
      );
    }

    if (status === "error") {
      showSmartAlert(
        "Algo no salió bien", 
        "Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.", 
        "error"
      );
    }

    function showSmartAlert(title, message, type) {
      const alertContainer = document.createElement("div");
      
      // CLAVES DEL CAMBIO:
      // 1. Centrado: left-1/2 junto con -translate-x-1/2
      // 2. Interacción: cursor-pointer para indicar que es clickeable
      alertContainer.className = `
        fixed top-24 left-1/2 -translate-x-1/2 z-[100] 
        w-[90%] max-w-md p-1 rounded-[2rem] cursor-pointer
        bg-gradient-to-br ${type === 'success' ? 'from-brand-cyan/40 to-brand-coral/40' : 'from-red-500/40 to-orange-500/40'}
        backdrop-blur-2xl shadow-2xl opacity-0 -translate-y-4 transition-all duration-500 ease-out
        hover:scale-[1.02] active:scale-95
      `;

      alertContainer.innerHTML = `
        <div class="bg-[#1e296b]/95 rounded-[1.9rem] p-8 flex flex-col items-center text-center border border-white/10 select-none">
          <div class="w-16 h-16 mb-6 rounded-full flex items-center justify-center ${type === 'success' ? 'bg-brand-cyan/20 text-brand-cyan' : 'bg-red-500/20 text-red-500'}">
            ${type === 'success' 
              ? '<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
              : '<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>'
            }
          </div>
          <h3 class="text-white font-title text-2xl font-bold mb-2">${title}</h3>
          <p class="text-white/70 font-light leading-relaxed mb-2">${message}</p>
          <span class="text-white/30 text-[10px] uppercase tracking-widest mt-4">Click para cerrar</span>
        </div>
      `;

      document.body.appendChild(alertContainer);

      // Función para cerrar con animación
      const closeAlert = () => {
        alertContainer.classList.add("opacity-0", "-translate-y-4");
        setTimeout(() => {
          alertContainer.remove();
          // Limpiamos la URL para evitar que el pop-up salga al recargar
          if (window.location.search.includes('status=')) {
            window.history.replaceState({}, document.title, window.location.pathname);
          }
        }, 500);
      };

      // Animación de entrada
      setTimeout(() => {
        alertContainer.classList.remove("opacity-0", "-translate-y-4");
      }, 100);

      // CIERRE POR CLICK (En lugar de tiempo)
      alertContainer.addEventListener("click", closeAlert);
    }
  });
</script>

</html>
