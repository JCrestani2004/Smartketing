---
import "../styles/global.css";
const { title = "Smartketing" } = Astro.props;
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/smartketing/smart-simbolo.svg" />
    <link rel="icon" href="/smartketing/smart-simbolo.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <ClientRouter />
  <body class="bg-brand-gray/85">
    <Header />
    <slot />
    <Footer />
  </body>
 <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>

<script is:inline>
  // 1. Definimos la función de inicialización
  function initAOS() {
    AOS.init({
      duration: 1000,
      once: true,
      offset: 100,
    });
  }

  // 2. La ejecutamos cuando carga la página por primera vez
  initAOS();

  // 3. ¡ESTA ES LA CLAVE! 
  // Cada vez que Astro cambia de página (evento astro:after-swap), 
  // le decimos a AOS que refresque y vuelva a buscar elementos.
  document.addEventListener('astro:after-swap', () => {
    AOS.refresh(); // Despierta a AOS
    initAOS();     // Reinicia la configuración
  });
</script>

</html>
