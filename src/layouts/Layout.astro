---
import "../styles/global.css";
import fav from "../assets/brandoors/isotipo.svg";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "Brandoors",
  description = "Tu agencia de comunicación creativa para marcas en crecimiento.",
  image = "/og-image.jpg",
  imageWidth = 1200,
  imageHeight = 630,
} = Astro.props;

// URL canónica de la página actual (evita que Google la trate como contenido duplicado).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Imagen para compartir en redes (recomendado 1200x630). Reemplaza public/og-image.jpg por la real.
const ogImageURL = new URL(image, Astro.site);

// Datos estructurados: le explican a Google qué es Brandoors.
// ProfessionalService es un subtipo de LocalBusiness: le da a Google las señales
// que necesita para las búsquedas locales ("agencia de branding Panamá"), cosa
// que el tipo genérico Organization no hace.
//
// PENDIENTE: cuando tengan teléfono público y dirección fiscal, descomentar los
// campos de abajo. Google los usa para el panel lateral de resultados locales.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": new URL("/#organizacion", Astro.site).href,
  name: "Brandoors",
  alternateName: "Brandoors Estudio",
  url: Astro.site?.href,
  logo: new URL(fav.src, Astro.site).href,
  image: ogImageURL.href,
  description:
    "Estudio de comunicación creativa que ayuda a pymes a construir marcas con criterio y visión a largo plazo.",
  email: "contacto@brandoorsestudio.com",
  // telephone: "+507 0000 0000",
  // address: {
  //   "@type": "PostalAddress",
  //   addressLocality: "Ciudad de Panamá",
  //   addressCountry: "PA",
  // },
  knowsLanguage: ["es"],
  areaServed: [
    { "@type": "Country", name: "Panamá" },
    { "@type": "Country", name: "Colombia" },
  ],
  serviceType: [
    "Consultoría comercial",
    "Posicionamiento estratégico",
    "Branding visual",
    "Diseño web",
  ],
  sameAs: ["https://instagram.com/brandoors.estudio"],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={fav.src} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    {/*
      Tipografías auto-alojadas. Emite los @font-face y el link rel=preload
      del archivo que necesita el primer pintado. Plus Jakarta Sans es la del
      h1 del hero, así que es la única que se precarga: precargarlas todas
      competiría por ancho de banda con lo que sí bloquea el render.
    */}
    <Font cssVariable="--font-jakarta" preload={[{ style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-grotesk" />

    {/*
      Estado inicial de las animaciones de scroll. Va inline y en el head para
      que aplique en el primer pintado, en vez de esperar al bundle de motion.
      Sin esto el contenido aparecía, desaparecía y volvía.
    */}
    <script is:inline>
      (function () {
        var raiz = document.documentElement;
        raiz.classList.add("motion-ready");
        // Red de seguridad: si el bundle de animaciones nunca llega a arrancar,
        // mostramos el contenido igualmente en lugar de dejarlo invisible.
        setTimeout(function () {
          if (!raiz.hasAttribute("data-motion-activo")) {
            raiz.classList.remove("motion-ready");
          }
        }, 2500);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph: vista previa al compartir en WhatsApp, Facebook, LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Brandoors" />
    <meta property="og:locale" content="es_LA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {/* Con las medidas declaradas, WhatsApp y Facebook pintan la vista previa
        sin esperar a descargar la imagen para medirla. */}
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Datos estructurados (Schema.org) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    {/* Va dentro del head: fuera de él el HTML no es válido. */}
    <ClientRouter />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script>
      import { createObserver } from "../lib/motion/observer";

      document.addEventListener("astro:page-load", () => {
        createObserver()
      })
    </script>

    <script>
  document.addEventListener("astro:page-load", () => {
    const params = new URLSearchParams(window.location.search);
    const status = params.get("status");

    if (status === "success") {
      showSmartAlert(
        "¡Gracias por escribirnos!", 
        "Recibimos tu mensaje y muy pronto estaremos en contacto contigo.", 
        "success"
      );
    }

    if (status === "error") {
      showSmartAlert(
        "Algo no salió bien", 
        "Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.", 
        "error"
      );
    }

    function showSmartAlert(title: string, message: string, type: string) {
      const alertContainer = document.createElement("div");
      
      // CLAVES DEL CAMBIO:
      // 1. Centrado: left-1/2 junto con -translate-x-1/2
      // 2. Interacción: cursor-pointer para indicar que es clickeable
      alertContainer.className = `
        fixed top-24 left-1/2 -translate-x-1/2 z-[100] 
        w-[90%] max-w-md p-1 rounded-[2rem] cursor-pointer
        bg-gradient-to-br ${type === 'success' ? 'from-brand-cyan/40 to-brand-coral/40' : 'from-red-500/40 to-orange-500/40'}
        backdrop-blur-2xl shadow-2xl opacity-0 -translate-y-4 transition-all duration-500 ease-out
        hover:scale-[1.02] active:scale-95
      `;

      alertContainer.innerHTML = `
        <div class="bg-[#1e296b]/95 rounded-[1.9rem] p-8 flex flex-col items-center text-center border border-white/10 select-none">
          <div class="w-16 h-16 mb-6 rounded-full flex items-center justify-center ${type === 'success' ? 'bg-brand-cyan/20 text-brand-cyan' : 'bg-red-500/20 text-red-500'}">
            ${type === 'success' 
              ? '<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
              : '<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>'
            }
          </div>
          <h3 class="text-white font-title text-2xl font-bold mb-2">${title}</h3>
          <p class="text-white/70 font-light leading-relaxed mb-2">${message}</p>
          <span class="text-white/30 text-[10px] uppercase tracking-widest mt-4">Click para cerrar</span>
        </div>
      `;

      document.body.appendChild(alertContainer);

      // Función para cerrar con animación
      const closeAlert = () => {
        alertContainer.classList.add("opacity-0", "-translate-y-4");
        setTimeout(() => {
          alertContainer.remove();
          // Limpiamos la URL para evitar que el pop-up salga al recargar
          if (window.location.search.includes('status=')) {
            window.history.replaceState({}, document.title, window.location.pathname);
          }
        }, 500);
      };

      // Animación de entrada
      setTimeout(() => {
        alertContainer.classList.remove("opacity-0", "-translate-y-4");
      }, 100);

      // CIERRE POR CLICK (En lugar de tiempo)
      alertContainer.addEventListener("click", closeAlert);
    }
  });
    </script>
  </body>
</html>
