---
import "../styles/global.css";
const { title = "Smartketing", description = "Tu agencia de comunicación creativa para marcas en crecimiento." } = Astro.props;
import fav from "../assets/smart/smart-simbolo.svg"
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={fav.src} />
    <link rel="icon" href={fav.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <ClientRouter />
  <body class="bg-brand-gray/85">
    <Header />
    <slot />
    <Footer />
  </body>
 <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>

<script is:inline>
  // 1. Definimos la función de inicialización
  function initAOS() {
    AOS.init({
      duration: 1000,
      once: true,
      offset: 100,
    });
  }

  // 2. La ejecutamos cuando carga la página por primera vez
  initAOS();

  // 3. ¡ESTA ES LA CLAVE! 
  // Cada vez que Astro cambia de página (evento astro:after-swap), 
  // le decimos a AOS que refresque y vuelva a buscar elementos.
  document.addEventListener('astro:after-swap', () => {
    AOS.refresh(); // Despierta a AOS
    initAOS();     // Reinicia la configuración
  });
</script>
<script>
  const params = new URLSearchParams(window.location.search);
  const status = params.get("status");

  if (status === "success") {
    showAlert("Mensaje enviado correctamente ✅", "success");
  }

  if (status === "error") {
    showAlert("Hubo un error al enviar el mensaje ❌", "error");
  }

  function showAlert(message, type) {
    const alert = document.createElement("div");
    alert.innerText = message;

    alert.className =
      "fixed font-title top-6 right-6 px-6 py-4 rounded-xl shadow-lg text-brand-gray z-50 transition-all duration-500";

    if (type === "success") {
      alert.classList.add("bg-green-600");
    } else {
      alert.classList.add("bg-red-600");
    }

    document.body.appendChild(alert);

    setTimeout(() => {
      alert.style.opacity = "0";
      setTimeout(() => alert.remove(), 800);
    }, 3000);

    // Limpiar la URL después
    window.history.replaceState({}, document.title, "/");
  }
</script>

</html>
