# ============================================================================
#  Brandoors — Cabeceras, caché y reglas del servidor (Apache / LiteSpeed)
#  Este archivo se publica en la raíz del sitio. Si tu hosting NO usa Apache
#  ni LiteSpeed (p. ej. Nginx), pídele a tu proveedor las reglas equivalentes.
# ============================================================================

# ----------------------------------------------------------------------------
#  1) Redirección a HTTPS y host canónico
#     Sin esto, la misma página responde en hasta cuatro direcciones distintas
#     (http/https × con y sin www) y Google las trata como contenido duplicado.
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dominio anterior -> dominio actual, conservando la ruta.
    # El 301 es lo que le transfiere a brandoorsestudio.com el posicionamiento
    # que smartketingestudio.com haya acumulado. Mantener esta regla activa
    # al menos un año después de la migración.
    RewriteCond %{HTTP_HOST} ^(www\.)?smartketingestudio\.com$ [NC]
    RewriteRule ^(.*)$ https://brandoorsestudio.com/$1 [L,R=301]

    # Forzar HTTPS.
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Forzar la versión sin www.
    RewriteCond %{HTTP_HOST} ^www\.brandoorsestudio\.com$ [NC]
    RewriteRule ^(.*)$ https://brandoorsestudio.com/$1 [L,R=301]
</IfModule>

# ----------------------------------------------------------------------------
#  2) Caché del navegador
#     Todo lo que Astro emite en /_astro/ lleva un hash en el nombre: si el
#     contenido cambia, cambia el nombre del archivo. Por eso se puede cachear
#     un año sin riesgo de servir una versión vieja.
#     El HTML, en cambio, conserva siempre la misma URL, así que se revalida
#     en cada visita para que los cambios se vean al publicar.
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff|woff2|svg|png|jpe?g|gif|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(html|xml|txt)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# Respaldo para servidores donde mod_headers no está disponible.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/avif                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------------
#  3) Compresión
#     Hostinger ya sirve con Brotli desde su CDN, pero esto cubre el caso de
#     que se sirva directo desde Apache sin pasar por el CDN.
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ----------------------------------------------------------------------------
#  4) Cabeceras de seguridad
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Evita que el navegador "adivine" el tipo de archivo (anti-MIME-sniffing).
    Header always set X-Content-Type-Options "nosniff"

    # Impide que tu web se cargue dentro de un <iframe> de otro sitio (anti-clickjacking).
    Header always set X-Frame-Options "SAMEORIGIN"

    # Controla cuánta información de origen se envía al navegar a otros sitios.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Desactiva APIs del navegador que este sitio no necesita.
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

    # HSTS: obliga a usar HTTPS durante un año.
    # ACTÍVALO SÓLO cuando confirmes que todo el dominio, subdominios incluidos,
    # funciona por HTTPS. Una vez enviado, los navegadores lo recuerdan y no hay
    # forma rápida de dar marcha atrás.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # --- Content-Security-Policy (CSP): la protección más fuerte contra inyección
    #     de scripts. Ojo: las tipografías ahora son propias, pero los casos de
    #     éxito incrustan reels de Instagram, así que hace falta el frame-src.
    #     Actívala y prueba el sitio página por página antes de dejarla fija.
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src https://www.instagram.com; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'"
</IfModule>
